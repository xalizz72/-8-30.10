<Window x:Class="CarConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автосалон - Конфигуратор" Height="600" Width="500" Background="#F0F0F0">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="StepTitle" Text="Шаг 1: Модель и двигатель" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#333"/>
            <ProgressBar x:Name="StepProgress" Value="1" Maximum="5" Height="15" Margin="0,10,0,0" Foreground="#0078D7"/>
        </StackPanel>

        <TabControl x:Name="StepsTab" Grid.Row="1" SelectionChanged="StepsTab_SelectionChanged" Background="White" TabStripPlacement="Left">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <ContentPresenter ContentSource="Header" Visibility="Collapsed"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="1">
                <StackPanel Margin="20">
                    <TextBlock Text="Выберите модель:" FontWeight="Bold" FontSize="16"/>
                    <ComboBox x:Name="ModelCombo" SelectionChanged="ModelCombo_SelectionChanged">
                        <ComboBoxItem Content="Базовая (1 000 000 руб.)" IsSelected="True"/>
                        <ComboBoxItem Content="Спортивная (1 500 000 руб.)"/>
                        <ComboBoxItem Content="Люкс (2 000 000 руб.)"/>
                    </ComboBox>

                    <TextBlock Text="Выберите двигатель:" FontWeight="Bold" FontSize="16"/>
                    <ComboBox x:Name="EngineCombo" SelectionChanged="EngineCombo_SelectionChanged">
                        <ComboBoxItem Content="Бензин (+0 руб.)" IsSelected="True"/>
                        <ComboBoxItem Content="Дизель (+50 000 руб.)"/>
                        <ComboBoxItem Content="Электро (+150 000 руб.)"/>
                    </ComboBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="2">
                <StackPanel Margin="20">
                    <TextBlock Text="Выберите цвет:" FontWeight="Bold" FontSize="16"/>
                    <ComboBox x:Name="ColorCombo" SelectionChanged="ColorCombo_SelectionChanged">
                        <ComboBoxItem Content="Белый (+0 руб.)" IsSelected="True"/>
                        <ComboBoxItem Content="Черный (+20 000 руб.)"/>
                        <ComboBoxItem Content="Красный (+40 000 руб.)"/>
                    </ComboBox>

                    <TextBlock Text="Дополнительные опции:" FontWeight="Bold" FontSize="16" Margin="0,15,0,5"/>
                    <CheckBox x:Name="ClimateCheck" Content="Климат-контроль (+50 000)" Margin="0,5" Checked="Options_Changed" Unchecked="Options_Changed"/>
                    <CheckBox x:Name="AudioCheck" Content="Премиум аудио (+30 000)" Margin="0,5" Checked="Options_Changed" Unchecked="Options_Changed"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="3">
                <StackPanel Margin="20">
                    <TextBlock Text="Ваша конфигурация:" FontSize="18" FontWeight="Bold" Foreground="#0078D7"/>
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="14" Margin="0,10,0,20" LineHeight="25"/>

                    <TextBlock Text="Итоговая стоимость:" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="TotalPriceText" Text="0 руб." FontSize="24" Foreground="Green" FontWeight="Bold"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="4">
                <StackPanel Margin="20">
                    <TextBlock Text="Первоначальный взнос:" FontWeight="Bold" FontSize="16"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                        <Slider x:Name="InitialPaySlider" Minimum="10" Maximum="90" Value="20" Width="250" ValueChanged="LoanSlider_ValueChanged"/>
                        <TextBlock x:Name="InitialPayText" Text="20%" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold"/>
                    </StackPanel>

                    <TextBlock Text="Срок кредита (мес):" FontWeight="Bold" FontSize="16"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                        <Slider x:Name="LoanTermSlider" Minimum="12" Maximum="96" Value="12" Width="250" TickFrequency="12" IsSnapToTickEnabled="True" ValueChanged="LoanSlider_ValueChanged"/>
                        <TextBlock x:Name="LoanTermText" Text="12 мес." VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold"/>
                    </StackPanel>

                    <TextBlock Text="Расчет кредита:" FontWeight="Bold" FontSize="16" Margin="0,10,0,0"/>
                    <TextBlock x:Name="LoanDetailsText" TextWrapping="Wrap" FontSize="14" LineHeight="25"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="5">
                <StackPanel Margin="20">
                    <TextBlock Text="Оформление заявки:" FontWeight="Bold" FontSize="18" Foreground="#0078D7" Margin="0,0,0,15"/>

                    <TextBlock Text="Ваше имя (мин. 2 символа):"/>
                    <TextBox x:Name="NameBox" Margin="0,5,0,15" Padding="5" TextChanged="Form_TextChanged"/>

                    <TextBlock Text="Телефон (только цифры, мин. 5):"/>
                    <TextBox x:Name="PhoneBox" Margin="0,5,0,15" Padding="5" PreviewTextInput="PhoneBox_PreviewTextInput" TextChanged="Form_TextChanged"/>

                    <TextBlock Text="Email (должен содержать @):"/>
                    <TextBox x:Name="EmailBox" Margin="0,5,0,15" Padding="5" TextChanged="Form_TextChanged"/>

                    <TextBlock x:Name="FinalSummaryText" TextWrapping="Wrap" FontSize="14" Margin="0,15,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackBtn" Content="Назад" Grid.Column="0" Height="45" Click="BackBtn_Click" IsEnabled="False" Background="Gray"/>
            <Button x:Name="NextBtn" Content="Далее" Grid.Column="1" Height="45" Click="NextBtn_Click"/>
        </Grid>
    </Grid>
</Window>